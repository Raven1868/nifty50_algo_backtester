# Copy this file to `.env` and fill in real values. `.env` itself is
# git-ignored and must NEVER be committed — only this template (.env.example)
# with placeholder values belongs in version control.
#
# Nothing in the current backtester requires these — they're placeholders
# for if/when this project is extended toward paper trading or live
# execution via a broker API (see README section on using this for actual
# trading). Load them in code via secrets_config.get_secret(), never by
# reading config.yaml or hard-coding.

# Example broker API credentials (Zerodha Kite Connect / Upstox / Angel One
# SmartAPI / etc. — uncomment and rename to match whichever broker you use)
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_ACCESS_TOKEN=

# Optional: alerting/notification webhook (e.g. Telegram bot, Slack webhook)
# for live-run failure alerts
# ALERT_WEBHOOK_URL=
